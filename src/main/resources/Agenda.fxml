<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="650.0" prefWidth="1141.0" style="-fx-background-color: #F3F5F8;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sistema_gestao_pacientes.Agenda.AgendaController">
    <children>
        <VBox spacing="4.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Text fill="#233449" strokeType="OUTSIDE" strokeWidth="0.0" text="Agenda de Consultas">
                                    <font>
                                        <Font name="Arial Black" size="26.0" />
                                    </font>
                                </Text>
                                <Text fx:id="bemvindo" fill="#6d7c8e" strokeType="OUTSIDE" strokeWidth="0.0" text="Planeie as consultas e acompanhe a disponibilidade dos profissionais.">
                                    <font>
                                        <Font name="Arial" size="12.0" />
                                    </font>
                                </Text>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="BtnNovaConsulta" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #225F9E; -fx-background-radius: 5;" text="Nova consulta" textFill="WHITE">
                            <font>
                                <Font name="Arial Black" size="12.0" />
                            </font>
                            <graphic>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@imagens/Add.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <padding>
                                <Insets left="15.0" right="15.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

              <AnchorPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 10;" AnchorPane.bottomAnchor="55.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="90.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                    <children>
                  <Button fx:id="BtnAnterior" mnemonicParsing="false" prefHeight="32.0" prefWidth="53.0" style="-fx-background-color: white; -fx-border-color: DEE5ED; -fx-background-radius: 5;" text="&lt;" />
                  <Button fx:id="BtnSeguinte" mnemonicParsing="false" prefHeight="32.0" prefWidth="53.0" style="-fx-background-color: white; -fx-border-color: DEE5ED; -fx-background-radius: 5;" text="&gt;" />
                  <Button fx:id="BtnHoje" mnemonicParsing="false" prefHeight="32.0" prefWidth="53.0" style="-fx-background-color: white; -fx-border-color: DEE5ED; -fx-background-radius: 5;" text="Hoje" />
                  <Text fx:id="TxtSemana" strokeType="OUTSIDE" strokeWidth="0.0" text="5–9 outubro 2026">
                     <font>
                        <Font name="Arial" size="17.0" />
                     </font>
                  </Text>

                              <Region HBox.hgrow="ALWAYS" />

                              <ComboBox fx:id="ComboDr" prefHeight="40.0" prefWidth="172.0" promptText="Dra. Sofia Costa" style="-fx-background-color: #FFFFFF; -fx-border-color: #DEE5ED; -fx-border-radius: 5;" />

                              <Button fx:id="BtnDiario" mnemonicParsing="false" prefHeight="40.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #DEE5ED; -fx-border-radius: 5;" text="Diário" textFill="#233449">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <padding>
                                <Insets left="15.0" right="15.0" />
                            </padding>
                        </Button>
                  <Button fx:id="BtnSemanal" mnemonicParsing="false" prefHeight="40.0" prefWidth="110.0" style="-fx-background-color: #225F9E; -fx-border-color: #DEE5ED; -fx-border-radius: 5;" text="Semanal" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                     <padding>
                        <Insets left="15.0" right="15.0" />
                     </padding>
                  </Button>
                    </children>
                </HBox>

                <TableView fx:id="table" style="-fx-background-color: #FFFFFF; -fx-selection-bar: transparent; -fx-selection-bar-non-focused: transparent;" AnchorPane.bottomAnchor="65.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="70.0">
                    <columns>
                        <TableColumn fx:id="colEixoHora" prefWidth="60.0" style="-fx-background-color: #FFFFFF; -fx-alignment: TOP-CENTER; -fx-text-fill: #A0AAB5;" text="Hora" />

                        <TableColumn fx:id="colSegunda" prefWidth="180.0" style="-fx-background-color: #FFFFFF;" text="Segunda-feira" />
                        <TableColumn fx:id="colTerca" prefWidth="180.0" style="-fx-background-color: #FFFFFF;" text="Terça-feira" />
                        <TableColumn fx:id="colQuarta" prefWidth="180.0" style="-fx-background-color: #FFFFFF;" text="Quarta-feira" />
                        <TableColumn fx:id="colQuinta" prefWidth="180.0" style="-fx-background-color: #FFFFFF;" text="Quinta-feira" />
                        <TableColumn fx:id="colSexta" prefWidth="180.0" style="-fx-background-color: #FFFFFF;" text="Sexta-feira" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0">
                    <children>
                  <ImageView fitHeight="13.0" fitWidth="13.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/azul.png" />
                     </image>
                  </ImageView>
                        <Text fill="#6d7c8e" strokeType="OUTSIDE" strokeWidth="0.0" text="Consultas Confirmadas">
                            <font>
                                <Font name="Arial" size="12.0" />
                            </font>
                        </Text>
                  <ImageView fitHeight="13.0" fitWidth="13.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/vermelho.png" />
                     </image>
                  </ImageView>
                  <Text fill="#6d7c8e" strokeType="OUTSIDE" strokeWidth="0.0" text="Consultas Canceladas">
                     <font>
                        <Font name="Arial" size="12.0" />
                     </font>
                  </Text>
                  <ImageView fitHeight="13.0" fitWidth="13.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/verde.png" />
                     </image>
                  </ImageView>
                  <Text fill="#6d7c8e" strokeType="OUTSIDE" strokeWidth="0.0" text="Horários Livres">
                     <font>
                        <Font name="Arial" size="12.0" />
                     </font>
                  </Text>

                              <Region HBox.hgrow="ALWAYS" />

                              <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Text fill="#6d7c8e" strokeType="OUTSIDE" strokeWidth="0.0" text="Hora local · São Paulo" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <HBox alignment="CENTER_LEFT" spacing="8.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0">
            <children>
                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@imagens/calendario.png" />
                    </image>
                </ImageView>
                <Text fx:id="txtConsultas" fill="#6d7c8e" strokeType="OUTSIDE" strokeWidth="0.0" text="Hoje, Dra. Sofia Costa: 2 consultas confirmadas · 1 cancelada · Horários disponíveis para marcação" />
            </children>
        </HBox>
    </children>
</AnchorPane>
